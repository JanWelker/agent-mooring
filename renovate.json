{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>JanWelker/renovate-config"
  ],
  "packageRules": [
    {
      "description": "The CRDs catalog moves daily; one digest bump a week is enough for CI schemas.",
      "matchDepNames": ["https://github.com/datreeio/CRDs-catalog"],
      "schedule": ["* 0-5 * * 1"]
    }
  ],
  "customManagers": [
    {
      "description": "Tool and package versions pinned by ARG in the Dockerfile and by env in the workflows, each under a `# renovate:` comment.",
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)Dockerfile$/",
        "/^\\.github/workflows/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)(?:\\s+extractVersion=(?<extractVersion>\\S+))?\\s*\\n\\s*(?:ARG\\s+)?[A-Z0-9_]+(?:=|:\\s*)[\"']?(?<currentValue>[^\"'\\s]+)[\"']?"
      ]
    },
    {
      "description": "Git commits pinned by env in the workflows, under a `# renovate: datasource=git-refs` comment naming the tracked branch.",
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>git-refs)\\s+depName=(?<depName>\\S+)\\s+currentValue=(?<currentValue>\\S+)\\s*\\n\\s*[A-Z0-9_]+:\\s*(?<currentDigest>[a-f0-9]{40})"
      ]
    }
  ]
}
