#!/bin/bash
# SessionStart hook from managed-settings.json. Prints what this agent can
# reach, which Claude Code adds to the session context.
set -uo pipefail

echo "Agent environment (claude-${AGENT_SESSION:-agent}):"
if agent-token github >/dev/null; then
  if login="$(timeout 10 gh api user --jq .login 2>/dev/null)"; then
    echo "- GitHub: authenticated as $login"
  else
    echo "- GitHub: a token is mounted but the API call failed"
  fi
else
  echo "- GitHub: no token; no pushes or PRs"
fi
repos="${AGENT_REPOS:-${AGENT_REPO:-}}"
if [ -n "$repos" ]; then
  echo "- Repositories you own (cloned into \$HOME; the entrypoint never pulls or resets them):"
  for repo in $repos; do
    dir="$HOME/${repo##*/}"
    if [ -d "$dir/.git" ]; then
      echo "  - $repo at $dir"
    else
      echo "  - $repo: not cloned"
    fi
  done
fi
skills="${AGENT_SKILLS_REPO:-}"
if [ -n "$skills" ]; then
  sdir="$HOME/.claude/skills"
  if [ -e "$sdir/.git" ]; then
    timeout 10 git -C "$sdir" pull --ff-only -q >/dev/null 2>&1 || true
    head="$(git -C "$sdir" rev-parse --short HEAD 2>/dev/null || echo unknown)"
    echo "- Skills: $skills at $head in ~/.claude/skills"
  elif ! agent-token github >/dev/null; then
    echo "- Skills: $skills not available; no GitHub token"
  else
    echo "- Skills: $skills not cloned into ~/.claude/skills (see the entrypoint log)"
  fi
fi
if [ -r /var/run/secrets/kubernetes.io/serviceaccount/token ]; then
  sa="$(timeout 10 kubectl auth whoami -o jsonpath='{.status.userInfo.username}' 2>/dev/null || echo unknown)"
  echo "- Kubernetes: in-cluster as $sa (access: ${AGENT_KUBERNETES_ACCESS:-unknown}); check with kubectl auth can-i"
else
  echo "- Kubernetes: no service account token; no cluster access"
fi
if agent-token argocd >/dev/null; then
  echo "- Argo CD: argocd CLI configured for ${ARGOCD_SERVER:-?}"
fi
exit 0
