#!/bin/bash
# The TLS sidecar: terminates TLS on :2222 with the session's certificate and
# forwards to sshd on loopback. socat reads the certificate once at start, so
# this restarts the listener when cert-manager renews it. Open connections are
# forked children and keep running across the restart.
set -euo pipefail

CERT="${TLS_CERT:-/tls/tls.crt}"
KEY="${TLS_KEY:-/tls/tls.key}"
PORT="${TLS_PORT:-2222}"
TARGET="${SSHD_ADDRESS:-127.0.0.1:2223}"
INTERVAL="${TLS_RELOAD_INTERVAL:-60}"

fingerprint() { cat "$CERT" "$KEY" 2>/dev/null | sha256sum; }

pid=""
trap '[ -n "$pid" ] && kill "$pid" 2>/dev/null; exit 0' TERM INT

while true; do
  loaded="$(fingerprint)"
  socat -d0 \
    "OPENSSL-LISTEN:${PORT},reuseaddr,fork,cert=${CERT},key=${KEY},verify=0" \
    "TCP:${TARGET}" &
  pid=$!
  while kill -0 "$pid" 2>/dev/null; do
    sleep "$INTERVAL" &
    wait $! || true
    if [ "$(fingerprint)" != "$loaded" ]; then
      echo "tls-proxy: certificate changed, restarting the listener" >&2
      kill -KILL "$pid"
      wait "$pid" 2>/dev/null || true
      continue 2
    fi
  done
  wait "$pid" && status=0 || status=$?
  echo "tls-proxy: socat exited with $status" >&2
  exit 1
done
