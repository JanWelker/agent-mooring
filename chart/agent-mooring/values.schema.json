{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "session"
  ],
  "properties": {
    "session": {
      "type": "string",
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
      "minLength": 1,
      "maxLength": 50
    },
    "repo": {
      "type": "string",
      "description": "Deprecated: use repos.",
      "pattern": "^$|^[A-Za-z0-9-]+/[A-Za-z0-9._-]+$"
    },
    "skills": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repo": {
          "type": "string",
          "description": "owner/name of the shared skills repository, or empty.",
          "pattern": "^$|^[A-Za-z0-9-]+/[A-Za-z0-9._-]+$"
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._/-]+$"
        }
      }
    },
    "repos": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9-]+/[A-Za-z0-9._-]+$"
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^(sha256:[a-f0-9]{64})?$"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "kubernetes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "access": {
          "enum": [
            "none",
            "read",
            "write"
          ]
        }
      }
    },
    "argocd": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "server": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "ssh": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "authorizedKeys": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(ssh-|ecdsa-|sk-)\\S+ \\S+"
          }
        },
        "gateway": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "namespace": {
              "type": "string",
              "minLength": 1
            },
            "sectionName": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "domain": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "tls": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": {
          "type": "string",
          "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
        },
        "issuerRef": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "enum": [
                "ClusterIssuer",
                "Issuer"
              ]
            }
          }
        }
      }
    },
    "acp": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "appa": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "policy": {
          "type": "string"
        }
      }
    },
    "mcpServers": {
      "type": "object",
      "additionalProperties": {
        "type": "object"
      }
    },
    "extraEgressFQDNs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "matchName": {
            "type": "string",
            "minLength": 1
          },
          "matchPattern": {
            "type": "string",
            "minLength": 1
          },
          "port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          }
        },
        "oneOf": [
          {
            "required": [
              "matchName"
            ],
            "not": {
              "required": [
                "matchPattern"
              ]
            }
          },
          {
            "required": [
              "matchPattern"
            ],
            "not": {
              "required": [
                "matchName"
              ]
            }
          }
        ]
      }
    },
    "settings": {
      "type": "object"
    },
    "claudeMd": {
      "type": "string"
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingClaim": {
          "type": "string"
        },
        "size": {
          "type": "string",
          "pattern": "^[0-9]+(Ki|Mi|Gi|Ti)$"
        },
        "storageClass": {
          "type": "string"
        }
      }
    },
    "resources": {
      "type": "object"
    },
    "secretStore": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "ClusterSecretStore",
            "SecretStore"
          ]
        }
      }
    },
    "extraEnv": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "nodeSelector": {
      "type": "object"
    },
    "tolerations": {
      "type": "array"
    },
    "affinity": {
      "type": "object"
    }
  }
}
